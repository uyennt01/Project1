          <mxGeometry height="120" width="300" x="760" y="90" as="geometry" />
        </mxCell>
        <mxCell id="w130KDH4wfcmJwh75nE9-5" parent="1" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;html=1;" value="&lt;b&gt;BƯỚC 4: NHẬP THÔNG TIN THỤ HƯỞNG&lt;br&gt;&lt;/b&gt;&lt;br&gt;Customer: Nhập số TK + ngân hàng&lt;br&gt;Service: Xác thực TK&lt;br&gt;Napas API: Inquiry Account → BENE_NAME" vertex="1">
          <mxGeometry height="120" width="300" x="1110" y="90" as="geometry" />
        </mxCell>
        <mxCell id="w130KDH4wfcmJwh75nE9-6" parent="1" style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;fontStyle=1;whiteSpace=wrap;html=1;" value="BƯỚC 5: NHẬP SỐ TIỀN&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Customer: Nhập amount + nội dung&lt;br&gt;Service: Kiểm tra hạn mức, tính phí&lt;br&gt;Oracle: Bảng hạn mức, biểu phí&lt;br&gt;Core Banking: Check balance&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="300" x="60" y="260" as="geometry" />
        </mxCell>
        <mxCell id="w130KDH4wfcmJwh75nE9-7" parent="1" style="rounded=1;fillColor=#FFF8E1;strokeColor=#F57F17;strokeWidth=3;fontSize=12;align=left;spacingLeft=10;fontStyle=1;whiteSpace=wrap;html=1;" value="BƯỚC 6: XÁC NHẬN&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Customer: Xác nhận thông tin&lt;br&gt;Service: Tạo bản ghi GD&lt;br&gt;Oracle: INSERT OMNI_TRANSACTION&lt;br&gt;Oracle: INSERT OMNI_TRANSACTION_PHASE&lt;br&gt;STATUS: 0 (Init), PHASE: INIT&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="300" x="410" y="260" as="geometry" />
        </mxCell>
        <mxCell id="w130KDH4wfcmJwh75nE9-8" parent="1" style="rounded=1;fillColor=#E1F5FE;strokeColor=#01579B;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;html=1;" value="&lt;b&gt;BƯỚC 7: XÁC THỰC OTP&lt;br&gt;&lt;/b&gt;&lt;br&gt;Customer: Nhập OTP&lt;br&gt;Service: Tạo/gửi/xác thực OTP&lt;br&gt;SMS Gateway / Facepay API&lt;br&gt;Oracle: Update AUTH_METHOD&lt;br&gt;PHASE: SEND_OTP, VERIFY_OTP" vertex="1">
          <mxGeometry height="120" width="300" x="760" y="260" as="geometry" />
        </mxCell>
